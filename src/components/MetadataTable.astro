---
interface Row {
  label: string;
  value: string;
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;
---
<table class="meta-table">
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row">{row.label}</th>
        <td>{row.value}</td>
      </tr>
    ))}
  </tbody>
</table>
