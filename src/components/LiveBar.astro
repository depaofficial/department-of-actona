---
import { url } from "../lib/url";

interface Props {
  enabled: boolean;
  label: string;
  text?: string;
  href?: string;
}

const { enabled, label, text, href } = Astro.props;
---

{enabled && text && (
  <div class="live-bar" role="status" aria-live="polite">
    <span class="live-bar__label"><span class="live-dot" aria-hidden="true"></span>{label}</span>
    {href ? (
      <a class="live-bar__text" href={url(href)}>
        {text}
        <span class="live-bar__more">&rarr;</span>
      </a>
    ) : (
      <span class="live-bar__text">{text}</span>
    )}
  </div>
)}