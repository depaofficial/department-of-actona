---
import logoplain from "../images/logoplain.svg";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Department of ACTONA — website under construction." />
    <title>Department of ACTONA</title>
  </head>
  <body>
    <main class="wall">
      <img class="wall__logo" src={logoplain.src} alt="Department of ACTONA" />
      <p class="wall__title">DEPARTMENT OF ACTONA</p>
      <p class="wall__message">This website is currently under construction.</p>
      <p class="wall__year">UNITED NATIONS OF AC</p>
    </main>
  </body>
</html>

<style>
  @import "@fontsource/ibm-plex-sans/400.css";
  @import "@fontsource/ibm-plex-sans/600.css";

  :root {
    --brand-900: #0b2a4a;
    --font-sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body { background: var(--brand-900); }
  .wall {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    text-align: center;
    padding: 2rem;
  }
  .wall__logo { width: min(150px, 45vw); height: auto; }
  .wall__title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .wall__message {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.62);
  }
  .wall__year {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.38);
    margin-top: 0.5rem;
  }
</style>